# HakiOS fragment: Redmi Note 14 5G (beryl, MT6855)
# Hardware parameters for beryl (MediaTek Dimensity 7025 Ultra / MT6855)
CONFIG_DEVICE="beryl"
CONFIG_SOC="mt6855"
CONFIG_CPUS=8
CONFIG_GIC_V3=y
CONFIG_UFSHCI=y
CONFIG_UFS_SHARED_PA=0x60004000
CONFIG_FB_BASE=0xfe0c0000
CONFIG_PANEL_W=1080
CONFIG_PANEL_H=2400
CONFIG_PANEL_PITCH=4320
CONFIG_TOUCH_I2C=y
CONFIG_TOUCH_I2C_ADDR=0x38
CONFIG_TOUCH_FT3519T=y
CONFIG_KEYPAD=y
CONFIG_BOOTARGS="debug=0x8 serial=3 rd=md0 -v cpus=8 ufs=2 ufs_shared_pa=0x60004000"
