# Device images & dumps (must never be committed)
*.img
*.bin
*.apfs
kernel_patched
*.dtb
*.dts
fdt.*
stock_*

# Root temporary logs & dumps
/*.txt
!/mtkloader/map.txt
/devicetree/

# Firmware fetch dirs
fw-*/

# Cloned reference repositories (submodules or local clones)
/hakios/
/hakios-mt6768/
/hakios-uefi/
/hakios-metal/

# Temporary and build artifacts
build/
out/
*.o
*.elf
*.log

# Logs: track the final verified run
logs/*
!logs/last_run_pmsg.txt
!logs/last_run_console.txt
*-ramoops-*
__pycache__/
*.pyc

/scratch_*/
